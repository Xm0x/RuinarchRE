# --- Copyrighted game content: NEVER commit ---
# The original binaries stay on your machine only. The repo ships scripts that
# regenerate the baseline from a legit local install.
*.dll
*.exe
*.assets
*.resource
*.resS

# raw ilspycmd baseline (regenerate via tools/decompile.sh)
reference/
# compiled DLLs (tools/build.sh output)
build/
# hardlinked game copy for drop-in verify
testgame/
# Proton prefix for drop-in verify
testprefix/
# stock DLL backups made by tools/deploy.sh
*.orig

# --- Build artifacts ---
bin/
obj/
*.user
*.suo

# --- Ghidra ---
*.rep/
*.gpr
native/**/*.rep/

# --- Editor / OS ---
.vs/
.vscode/
.idea/
*.swp
.DS_Store

# --- logs ---
*.log
reference_build.log

# Allow-list: keep our own committed source even though *.dll is ignored above
!src/**/*.cs
