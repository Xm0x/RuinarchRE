<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Assembly-CSharp</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net40</TargetFramework>
    <!-- Absolute path to the game's Managed dir; keeps reference HintPaths robust. -->
    <RuinManaged>/home/user/.local/share/Steam/steamapps/common/Ruinarch/Ruinarch_Data/Managed</RuinManaged>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <!-- Compile against Unity's own base class libraries, not the SDK's net40
         reference assemblies. Mirrors how the game was originally built and
         resolves ExtensionAttribute/type-identity conflicts. -->
    <NoStdLib>True</NoStdLib>
    <DisableImplicitFrameworkReferences>True</DisableImplicitFrameworkReferences>
    <NoConfig>True</NoConfig>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>$(RuinManaged)/mscorlib.dll</HintPath></Reference>
    <Reference Include="System"><HintPath>$(RuinManaged)/System.dll</HintPath></Reference>
    <Reference Include="netstandard"><HintPath>$(RuinManaged)/netstandard.dll</HintPath></Reference>
  </ItemGroup>
