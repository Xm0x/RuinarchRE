<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Assembly-CSharp</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net40</TargetFramework>
    <!-- Resolved from the RUIN_MANAGED_DIR environment variable, or from
         src/Directory.Build.props (generated by tools/fix-csproj-paths.sh,
         gitignored). tools/build.sh does NOT need either: it drives Roslyn
         directly from $RUIN_MANAGED_DIR. This block is for IDE/MSBuild use. -->
    <RuinManaged Condition="'$(RuinManaged)'==''">$([System.Environment]::GetEnvironmentVariable('RUIN_MANAGED_DIR'))</RuinManaged>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <!-- Compile against Unity's own base class libraries, not the SDK's net40
         reference assemblies. Mirrors how the game was originally built and
         resolves ExtensionAttribute/type-identity conflicts. -->
    <NoStdLib>True</NoStdLib>
    <DisableImplicitFrameworkReferences>True</DisableImplicitFrameworkReferences>
    <NoConfig>True</NoConfig>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="mscorlib"><HintPath>$(RuinManaged)/mscorlib.dll</HintPath></Reference>
    <Reference Include="System"><HintPath>$(RuinManaged)/System.dll</HintPath></Reference>
    <Reference Include="netstandard"><HintPath>$(RuinManaged)/netstandard.dll</HintPath></Reference>
  </ItemGroup>
  <PropertyGroup />
  <ItemGroup />
